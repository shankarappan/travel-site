# NODE_ENV=development|test|production
NODE_ENV=development

# Public app URLs (also used as Auth.js canonical origin when AUTH_URL unset)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# AUTH_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# PostgreSQL (required for durable identity/consent/trips/commerce/conversations)
DATABASE_URL=postgresql://travel:travel@127.0.0.1:5432/travel
# DATABASE_POOL_MAX=10

# Auth (server-only — never expose to the client)
AUTH_SECRET=replace-with-long-random-string
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_APPLE_ID=
# AUTH_APPLE_SECRET=

# Transactional email (Resend) — required for production magic-link delivery
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=Aotearoa Trails <noreply@your-verified-domain.com>
